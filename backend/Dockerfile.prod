# ===== BUILDER STAGE =====
FROM node:20-alpine AS builder

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Copy workspace configuration files
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./

# Copy all required packages
COPY shared/ ./shared/
COPY backend/ ./backend/

# Install ALL dependencies (including devDependencies for building)
RUN pnpm install --frozen-lockfile

# Build shared package first
WORKDIR /app/shared
RUN pnpm build

# Generate Prisma client (output to shared/node_modules/.prisma/client)
WORKDIR /app/backend
RUN pnpm prisma generate

# Build backend
RUN pnpm build

# ===== RUNNER STAGE =====
FROM node:20-alpine AS runner

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Create app user for security
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nestjs

WORKDIR /app

# Copy workspace configuration
COPY --from=builder --chown=nestjs:nodejs /app/pnpm-workspace.yaml ./
COPY --from=builder --chown=nestjs:nodejs /app/package.json ./
COPY --from=builder --chown=nestjs:nodejs /app/pnpm-lock.yaml ./

# Copy shared package (built)
COPY --from=builder --chown=nestjs:nodejs /app/shared/package.json ./shared/
COPY --from=builder --chown=nestjs:nodejs /app/shared/dist ./shared/dist/
COPY --from=builder --chown=nestjs:nodejs /app/shared/node_modules ./shared/node_modules/

# Copy backend built files
COPY --from=builder --chown=nestjs:nodejs /app/backend/package.json ./backend/
COPY --from=builder --chown=nestjs:nodejs /app/backend/dist ./backend/dist/
COPY --from=builder --chown=nestjs:nodejs /app/backend/node_modules ./backend/node_modules/

# Copy Prisma files (needed for migrations)
COPY --from=builder --chown=nestjs:nodejs /app/backend/prisma ./backend/prisma/

# Install production dependencies only
RUN pnpm install --prod --frozen-lockfile

WORKDIR /app/backend

# Switch to non-root user
USER nestjs

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3000/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Start command (with migration)
CMD ["sh", "-c", "pnpm prisma migrate deploy && node dist/main.js"]
