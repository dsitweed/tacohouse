// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

generator nestjsDto {
  provider                      = "prisma-generator-nestjs-dto"
  output                        = "../src/generated/nestjs-dto"
  reExport                      = "true"
  generateFileTypes             = "entity"
  exportRelationModifierClasses = "false"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String   @id @default(uuid())
  email    String   @unique
  role     UserRole
  isActive Boolean  @default(true)

  // Profile information
  profile UserProfile?

  // Auth: server-side sessions & linked providers (credential / Google OAuth)
  sessions Session[]
  accounts Account[]

  // Role-specific relations (integrity enforced via composite FK on the referencing side)
  buildings            Building[]            @relation("BuildingLandlord")
  rentals              Rental[]              @relation("RentalTenant")
  maintenanceRequests  MaintenanceRequest[]  @relation("MaintenanceTenant")
  paymentConfirmations PaymentConfirmation[] @relation("ConfirmationTenant")

  // Chat and notifications
  sentMessages     Message[]      @relation("MessageSender")
  receivedMessages Message[]      @relation("MessageRecipient")
  notifications    Notification[]

  // Each ChatGroupMember record links user to a chat group. 
  // At one time, a tenant can only belong to 1 room - 1 building - 1 chatGroup. 
  // But a landlord can own many buildings - belong to many chatGroups.
  chatGroupMember ChatGroupMember[]

  deletedAt DateTime? // softDelete
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Composite unique lets referencing tables target (id, role) to pin the
  // owner's role at the database level (e.g. a Building's landlord must be LANDLORD).
  @@unique([id, role])
  @@index([role])
  @@map("users")
}

model UserProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName   String
  lastName    String
  phone       String
  avatar      String? // key to avatar image in bucket
  dateOfBirth DateTime
  occupation  String
  workplace   String

  // Identity documents
  idCardFrontPhoto String? // key to front side of ID card in bucket
  idCardBackPhoto  String? // key to back side of ID card in bucket
  portraitPhoto    String? // key to portrait photo for verification in bucket

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_profiles")
}

// Auth: server-side session store (refresh tokens, device/IP tracking, revocation)
model Session {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token     String   @unique // opaque/refresh token (store a hash in production)
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

// Auth: linked authentication providers per user (credential + OAuth like Google)
model Account {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  providerId String // 'credential' | 'google' | ...
  accountId  String // the provider's user id (or this user's id for credential)

  password              String?   @db.VarChar(255) // hash, only for providerId = 'credential'
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

// Auth: short-lived tokens for email verification, password reset, magic link, OTP
model Verification {
  id         String   @id @default(uuid())
  identifier String // email / userId / purpose key (e.g. "reset:user@mail.com")
  value      String // token or OTP (store a hash in production)
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Building {
  id String @id @default(uuid())

  landlordId   String
  landlordRole UserRole @default(LANDLORD) // pins owner to a LANDLORD user via composite FK
  landlord     User     @relation("BuildingLandlord", fields: [landlordId, landlordRole], references: [id, role], onDelete: Cascade)

  name        String
  address     String
  description String?
  billingDate Int? // Day of month for billing

  // Utility rates for this building
  electricityRate      Decimal @default(0) @db.Decimal(12, 2) // Per kWh
  waterRate            Decimal @default(0) @db.Decimal(12, 2) // Per cubic meter
  gasRate              Decimal @default(0) @db.Decimal(12, 2) // Per cubic meter
  managementFee        Decimal @default(0) @db.Decimal(12, 2) // Fixed monthly fee
  cleaningFeePerPerson Decimal @default(0) @db.Decimal(12, 2) // Per person monthly
  lightingFee          Decimal @default(0) @db.Decimal(12, 2) // Fixed monthly fee

  rooms Room[]

  // Chat group for building residents
  chatGroup ChatGroup?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([landlordId])
  @@map("buildings")
}

model Room {
  id         String   @id @default(uuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  // Room details
  number        String
  area          Decimal    @db.Decimal(10, 2)
  monthlyRent   Decimal    @db.Decimal(14, 2)
  deposit       Decimal    @default(0) @db.Decimal(14, 2)
  maxTenants    Int        @default(1)
  roomType      RoomType
  description   String?
  images        String[] // Array of key for images in bucket
  status        RoomStatus @default(AVAILABLE)
  availableFrom DateTime?

  // Current rentals
  rentals Rental[]

  // Equipment in room
  equipment RoomEquipment[]

  // Utility consumption records
  utilityRecords UtilityRecord[]

  // Bill generated for this room
  bills Bill[]

  // Maintenance requests
  maintenanceRequests MaintenanceRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([number, buildingId])
  @@index([buildingId])
  @@map("rooms")
}

model RoomEquipment {
  id     String @id @default(uuid())
  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  name               String // washing machine, refrigerator, air conditioner, etc.
  description        String?
  brand              String?
  model              String?
  installedDate      DateTime?
  warrantyExpiryDate DateTime?
  condition          EquipmentCondition @default(GOOD)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId])
  @@map("room_equipments")
}

// Rental Management
model Rental {
  id String @id @default(uuid())

  tenantId   String
  tenantRole UserRole @default(TENANT)
  tenant     User     @relation("RentalTenant", fields: [tenantId, tenantRole], references: [id, role], onDelete: Restrict)

  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Restrict)

  startDate  DateTime
  endDate    DateTime?
  noticeDate DateTime? // The date when the tenant officially notified the landlord about moving out

  monthlyRent Decimal @db.Decimal(14, 2)
  depositPaid Decimal @default(0) @db.Decimal(14, 2) // Deposit amount paid by the tenant, can be deducted from future rent payments

  status         RentalStatus @default(ACTIVE)
  contractImages String[] // Array of key for contract document images in bucket

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId, status])
  @@index([tenantId])
  @@map("rentals")
}

// Billing System
model Bill {
  id     String @id @default(uuid())
  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Restrict)

  billingPeriod DateTime // Start date of the billing cycle (e.g., first day → end of month)
  dueDate       DateTime

  // Base charges
  monthlyRent Decimal @db.Decimal(14, 2)

  // Utility charges (only for PARTIAL_RIGHTS rooms)
  electricityUsage  Decimal @default(0) @db.Decimal(12, 3)
  electricityAmount Decimal @default(0) @db.Decimal(14, 2)

  waterUsage  Decimal @default(0) @db.Decimal(12, 3)
  waterAmount Decimal @default(0) @db.Decimal(14, 2)

  gasUsage  Decimal @default(0) @db.Decimal(12, 3)
  gasAmount Decimal @default(0) @db.Decimal(14, 2)

  // Fixed fees
  managementFee Decimal @default(0) @db.Decimal(12, 2)
  cleaningFee   Decimal @default(0) @db.Decimal(12, 2)
  lightingFee   Decimal @default(0) @db.Decimal(12, 2)

  // Outstanding debt
  previousDebt Decimal @default(0) @db.Decimal(14, 2)

  // Total amount
  totalAmount Decimal @db.Decimal(14, 2)

  status BillStatus @default(PENDING)

  // Payment tracking
  payment Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, billingPeriod])
  @@index([roomId, status])
  @@map("bills")
}

model Payment {
  id     String @id @default(uuid())
  billId String @unique
  bill   Bill   @relation(fields: [billId], references: [id], onDelete: Restrict)

  amount        Decimal       @db.Decimal(14, 2)
  paymentMethod PaymentMethod
  paymentDate   DateTime      @default(now())

  // Payment details
  stripePaymentId String? // For Stripe payments
  bankTransferRef String? // For bank transfers
  notes           String?
  receiptImage    String? // Receipt/proof image

  status PaymentStatus

  // Two-party confirmation for this payment
  confirmation PaymentConfirmation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

model PaymentConfirmation {
  id        String  @id @default(uuid())
  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  tenantId   String
  tenantRole UserRole @default(TENANT)
  tenant     User     @relation("ConfirmationTenant", fields: [tenantId, tenantRole], references: [id, role], onDelete: Restrict)

  tenantConfirmed   Boolean   @default(false)
  tenantConfirmedAt DateTime?

  landlordConfirmed   Boolean   @default(false)
  landlordConfirmedAt DateTime?

  proofImages String[] // Array of key for payment proof images in bucket
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("payment_confirmations")
}

// Utility Tracking
model UtilityRecord {
  id     String @id @default(uuid())
  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Restrict)

  recordDate  DateTime
  utilityType UtilityType

  // Meter readings
  previousReading Decimal @default(0) @db.Decimal(12, 3)
  currentReading  Decimal @db.Decimal(12, 3)
  consumption     Decimal @db.Decimal(12, 3) // Calculated: current - previous

  // Rates at time of recording
  unitRate Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, utilityType, recordDate])
  @@map("utility_records")
}

// Communication System
model ChatGroup {
  id         String   @id @default(uuid())
  buildingId String   @unique
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  name        String
  description String?

  messages Message[]
  members  ChatGroupMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("chat_groups")
}

model ChatGroupMember {
  id          String    @id @default(uuid())
  chatGroupId String
  chatGroup   ChatGroup @relation(fields: [chatGroupId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([chatGroupId, userId])
  @@index([userId])
  @@map("chat_group_members")
}

model Message {
  id String @id @default(uuid())

  senderId   String
  senderUser User   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  content     String
  messageType MessageType @default(TEXT)

  // Attachment metadata for IMAGE / FILE messages
  attachmentUrl  String?
  attachmentName String?
  attachmentSize Int?

  // For group messages
  chatGroupId String?
  chatGroup   ChatGroup? @relation(fields: [chatGroupId], references: [id], onDelete: Cascade)

  // For direct messages
  recipientId   String?
  recipientUser User?   @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  readAt DateTime? // Read tracking for direct messages

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chatGroupId, createdAt])
  @@index([recipientId, senderId])
  @@index([senderId])
  @@map("messages")
}

// Maintenance System
model MaintenanceRequest {
  id String @id @default(uuid())

  tenantId   String
  tenantRole UserRole @default(TENANT)
  tenant     User     @relation("MaintenanceTenant", fields: [tenantId, tenantRole], references: [id, role], onDelete: Cascade)

  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  title       String
  description String
  priority    PriorityType        @default(MEDIUM)
  category    MaintenanceCategory

  images String[] // Problem images

  status MaintenanceStatus @default(PENDING)

  // Response from landlord
  completedAt    DateTime?
  completionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId, status])
  @@index([tenantId])
  @@map("maintenance_requests")
}

// Notification System
model Notification {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  message String
  type    NotificationType

  isRead Boolean   @default(false)
  readAt DateTime?

  // Optional reference to related entity
  relatedId   String?
  relatedType RelatedEntityType?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isRead])
  @@map("notifications")
}

// Enums - Role
enum UserRole {
  ADMIN
  LANDLORD
  TENANT
}

// Enums - Type
enum RoomType {
  FULL_RIGHTS // only pay rent
  PARTIAL_RIGHTS // pay rent + utilities
}

enum UtilityType {
  ELECTRICITY
  WATER
  GAS
}

enum MessageType {
  TEXT
  IMAGE
  FILE
}

enum PriorityType {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  BILL_GENERATED
  PAYMENT_REMINDER
  MAINTENANCE_UPDATE
  CHAT_MESSAGE
  ANNOUNCEMENT
  SYSTEM
}

enum RelatedEntityType {
  BILL
  PAYMENT
  RENTAL
  MAINTENANCE_REQUEST
  MESSAGE
  ROOM
  BUILDING
}

// Enums - Status
enum RoomStatus {
  AVAILABLE // Available room
  OCCUPIED // Currently occupied
  PENDING_CHECKOUT // Waiting for tenant to move out
  MAINTENANCE // Under maintenance
}

enum RentalStatus {
  ACTIVE // Rental contract is active
  NOTICE_GIVEN // Tenant has given notice to move out
  TERMINATED // Rental contract has ended
}

enum BillStatus {
  PENDING
  PAID
  TENANT_CONFIRMED
  LANDLORD_CONFIRMED
  OVERDUE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum MaintenanceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Enums - Other
enum EquipmentCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  BROKEN
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  STRIPE
}

enum MaintenanceCategory {
  PLUMBING
  ELECTRICAL
  APPLIANCE
  FURNITURE
  CLEANING
  OTHER
}
