# Production Environment Variables Template
# Copy this file to .env.production and fill in the values

# ===== Database =====
DATABASE_URL=postgresql://tacohouse:your_password@postgres:5432/tacohouse
POSTGRES_DB=tacohouse
POSTGRES_USER=tacohouse
POSTGRES_PASSWORD=your_strong_password_here

# ===== Backend =====
NODE_ENV=production
PORT=3000
BACKEND_PORT=3001

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_long
JWT_EXPIRES_IN=7d

# ===== Redis =====
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=your_redis_password
REDIS_PORT=6379

# ===== Frontend =====
FRONTEND_PORT=3000
NEXT_PUBLIC_API_ORIGIN=http://localhost:3001

# For production deployment, use your actual domain:
# NEXT_PUBLIC_API_ORIGIN=https://api.tacohouse.com

# ===== Email (if using) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ===== File Storage (if using Cloudinary) =====
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ===== Stripe (if using) =====
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ===== Monitoring (Optional) =====
SENTRY_DSN=https://...@sentry.io/...

# ===== CORS =====
CORS_ORIGIN=http://localhost:3000,https://tacohouse.com
